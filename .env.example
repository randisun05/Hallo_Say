TELEGRAM_BOT_TOKEN=isi-token-dari-BotFather

# Provider LLM: "gemini" (gratis, default) atau "anthropic"
LLM_PROVIDER=gemini

# Wajib jika LLM_PROVIDER=gemini. Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Wajib jika LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Opsional. Kosongkan saat pertama kali dijalankan untuk melihat chat_id
# kamu di log, lalu isi supaya bot hanya merespons chat itu.
ALLOWED_CHAT_IDS=

# Opsional, default: ./data
DATA_DIR=./data

# Opsional — isi untuk mengaktifkan fitur Google Calendar/Drive/Gmail.
# Ambil dari Google Cloud Console (lihat README bagian "Setup Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
