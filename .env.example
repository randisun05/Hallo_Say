TELEGRAM_BOT_TOKEN=isi-token-dari-BotFather

# Provider LLM aktif: "gemini", "anthropic", atau "ollama" (self-hosted)
LLM_PROVIDER=ollama

# TODO: isi alamat VM Ollama kamu begitu sudah siap, mis. http://203.0.113.10:11434
# (localhost:11434 hanya benar kalau bot dan Ollama jalan di mesin yang sama)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# Alternatif lain, tinggal ganti LLM_PROVIDER di atas kalau mau pindah:
# Gemini — gratis, ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude — berbayar
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Opsional. Kosongkan saat pertama kali dijalankan untuk melihat chat_id
# kamu di log, lalu isi supaya bot hanya merespons chat itu.
ALLOWED_CHAT_IDS=

# Opsional, default: ./data
DATA_DIR=./data

# Opsional — isi untuk mengaktifkan fitur Google Calendar/Drive/Gmail.
# Ambil dari Google Cloud Console (lihat README bagian "Setup Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
